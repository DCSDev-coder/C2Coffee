NODE_ENV=development
DEPLOYMENT_TENANT_CODE=c2coffee
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
OTP_DELIVERY_MODE=stub
OTP_DEBUG_EXPOSE_CODE=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=90
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
# Optional Apple review account. Leave blank except during an active review.
REVIEW_ACCOUNT_PHONE_E164=
REVIEW_ACCOUNT_OTP_CODE=
ACCOUNT_RETENTION_YEARS=7

# Public API base URL. Phase 1 target should be api.c2coffeeandcandle.com,
# not the root website domain, because the root is intended for C2Web/Vercel.
PUBLIC_API_BASE_URL=https://api.c2coffeeandcandle.com/v1

# Comma-separated browser origins for web/admin clients.
# Mobile apps do not use browser CORS, but admin web and local tools do.
# Use the bare localhost origins below to allow any local port during development.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://admin.c2coffeeandcandle.com,https://c2coffeeandcandle.com,https://www.c2coffeeandcandle.com

# cPanel/phpMyAdmin MySQL database.
# Create the real DB/user in cPanel first; do not commit production credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=c2coffee_REPLACE_USER
DB_PASSWORD=REPLACE_WITH_CPANEL_DB_PASSWORD
DB_NAME=c2coffee_REPLACE_DB
DB_CONNECTION_LIMIT=10

# JWT/session secrets will be added when auth endpoints are implemented.
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# CHIP Collect is called only by the API; never place its secret key in a
# Flutter app. The API verifies callbacks by retrieving the authoritative
# purchase from CHIP before crediting tokens.
# As of 14 Oct 2026, enable only FPX and DuitNow QR. Cards and E-wallet stay
# excluded until CHIP marks them Active in the merchant portal.
TOPUP_GATEWAY_ENABLED=false
TOPUP_GATEWAY_PROVIDER=chip
TOPUP_GATEWAY_BASE_URL=https://gate.chip-in.asia/api/v1/
TOPUP_GATEWAY_API_KEY=
TOPUP_GATEWAY_BRAND_ID=
TOPUP_GATEWAY_ALLOWED_METHODS=fpx,duitnow_qr
# Confirm these exact codes against CHIP GET /payment_methods/ for the brand.
CHIP_FPX_METHOD_CODES=fpx
CHIP_DUITNOW_METHOD_CODES=duitnow_qr,dnqr
CHIP_CARD_METHOD_CODES=visa,mastercard,maestro
CHIP_EWALLET_METHOD_CODES=

# OTP providers.
# Development only: stub returns a debug code and log writes it to logs.
# Production refuses to start unless OTP_DELIVERY_MODE=email and
# OTP_DEBUG_EXPOSE_CODE=false.
WHATSAPP_CLOUD_API_TOKEN=REPLACE_WITH_META_WHATSAPP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
SMS_PROVIDER_BASE_URL=REPLACE_WITH_SMS_PROVIDER_URL
SMS_PROVIDER_API_KEY=REPLACE_WITH_SMS_PROVIDER_KEY

# SMTP is required for live OTP delivery, verified email changes, and support
# ticket forwarding. Support requests are delivered to this inbox.
EMAIL_SMTP_HOST=mail.c2coffeeandcandle.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=no-reply@c2coffeeandcandle.com
EMAIL_SMTP_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
EMAIL_FROM_ADDRESS=no-reply@c2coffeeandcandle.com
EMAIL_FROM_NAME=C2 Coffee & Candle
SUPPORT_EMAIL_ADDRESS=support@c2coffeeandcandle.com
COLLABORATION_EMAIL_ADDRESS=collabc2@c2coffeeandcandle.com

# Admin Web keeps its rotating refresh session in an HttpOnly cookie. Leave the
# domain blank for a host-only cookie, or set .c2coffeeandcandle.com when the
# admin web and API are served on separate subdomains.
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax

# Firebase Cloud Messaging server delivery. Keep disabled until a service
# account JSON value has been placed in the deployment secret store. Never
# commit this credential.
FCM_DELIVERY_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=

# Required by the local Print Bridge / approved POS connector. Generate a long
# random value and store it only in the deployment secret store.
PRINT_CONNECTOR_SHARED_SECRET=
