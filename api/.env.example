NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
OTP_DELIVERY_MODE=stub
OTP_DEBUG_EXPOSE_CODE=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
ACCOUNT_RETENTION_YEARS=7

# Public API base URL. Phase 1 target should be api.c2coffeeandcandle.com,
# not the root website domain, because the root is intended for C2Web/Vercel.
PUBLIC_API_BASE_URL=https://api.c2coffeeandcandle.com/v1

# Comma-separated browser origins for web/admin clients.
# Mobile apps do not use browser CORS, but admin web and local tools do.
# Add the local barista web port as well when testing the Flutter web build.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:60120,http://127.0.0.1:60120,https://admin.c2coffeeandcandle.com

# cPanel/phpMyAdmin MySQL database.
# Create the real DB/user in cPanel first; do not commit production credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=c2coffee_REPLACE_USER
DB_PASSWORD=REPLACE_WITH_CPANEL_DB_PASSWORD
DB_NAME=c2coffee_REPLACE_DB
DB_CONNECTION_LIMIT=10

# JWT/session secrets will be added when auth endpoints are implemented.
ACCESS_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Billplz phase-1 gateway credentials.
# Keep blank until payment routes are implemented on the server.
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_COLLECTION_ID=REPLACE_WITH_BILLPLZ_COLLECTION_ID
BILLPLZ_API_KEY=REPLACE_WITH_BILLPLZ_API_KEY
BILLPLZ_X_SIGNATURE_KEY=REPLACE_WITH_BILLPLZ_SIGNATURE_KEY

# OTP providers.
# Current API auth flow supports:
# - stub = store OTP and return debug code when OTP_DEBUG_EXPOSE_CODE=true
# - log  = store OTP and write the code to container logs
# Real WhatsApp/SMS delivery is still pending implementation.
WHATSAPP_CLOUD_API_TOKEN=REPLACE_WITH_META_WHATSAPP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
SMS_PROVIDER_BASE_URL=REPLACE_WITH_SMS_PROVIDER_URL
SMS_PROVIDER_API_KEY=REPLACE_WITH_SMS_PROVIDER_KEY
