{
  "name": "@c2coffee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-sql.mjs",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:referrals": "npm run build && node --test test/referrals.test.mjs",
    "test:admin-isolation": "npm run build && node --test test/admin-isolation.test.mjs",
    "test:topups": "npm run build && node --test test/topup-request.test.mjs test/chip-callback-key.test.mjs",
    "test:shift-access": "npm run build && node --test test/barista-shift-access.test.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "import:media": "tsx src/scripts/import-media-assets.ts",
    "import:media:prod": "node dist/scripts/import-media-assets.js",
    "cleanup:legacy-vouchers": "tsx src/scripts/cleanup-legacy-vouchers.ts",
    "cleanup:legacy-vouchers:prod": "node dist/scripts/cleanup-legacy-vouchers.js",
    "reset:vouchers": "tsx src/db/reset-vouchers.ts",
    "reset:vouchers:prod": "node dist/db/reset-vouchers.js",
    "reset:qa": "tsx src/db/reset-qa.ts",
    "reset:qa:prod": "node dist/db/reset-qa.js",
    "seed:demo": "tsx src/db/migrate.ts --seed-demo",
    "seed:demo:prod": "node dist/db/migrate.js --seed-demo",
    "production-readiness:prod": "node dist/scripts/production-readiness.js",
    "reconcile:chip": "tsx src/scripts/reconcile-chip-topups.ts",
    "reconcile:chip:prod": "node dist/scripts/reconcile-chip-topups.js",
    "preflight:admin": "tsx src/scripts/admin-deployment-preflight.ts",
    "preflight:admin:prod": "node dist/scripts/admin-deployment-preflight.js",
    "initialize:cafe": "tsx src/scripts/initialize-cafe-deployment.ts",
    "initialize:cafe:prod": "node dist/scripts/initialize-cafe-deployment.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.1",
    "pino": "^9.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
