{
  "name": "@c2coffee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sql.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "import:media": "tsx src/scripts/import-media-assets.ts",
    "import:media:prod": "node dist/scripts/import-media-assets.js",
    "cleanup:legacy-vouchers": "tsx src/scripts/cleanup-legacy-vouchers.ts",
    "cleanup:legacy-vouchers:prod": "node dist/scripts/cleanup-legacy-vouchers.js",
    "reset:vouchers": "tsx src/db/reset-vouchers.ts",
    "reset:vouchers:prod": "node dist/db/reset-vouchers.js",
    "reset:qa": "tsx src/db/reset-qa.ts",
    "reset:qa:prod": "node dist/db/reset-qa.js",
    "seed:demo": "tsx src/db/migrate.ts --seed-demo",
    "seed:demo:prod": "node dist/db/migrate.js --seed-demo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.6",
    "pino": "^9.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
