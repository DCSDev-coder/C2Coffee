NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Production uses SMTP OTP delivery. The API refuses to start with a debug
# delivery mode or exposed codes while NODE_ENV=production.
OTP_DELIVERY_MODE=email
OTP_DEBUG_EXPOSE_CODE=false

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
ACCOUNT_RETENTION_YEARS=7

PUBLIC_API_BASE_URL=https://api.c2coffeeandcandle.com/v1

# Add the real admin/browser origins when the admin panel is deployed.
CORS_ALLOWED_ORIGINS=https://admin.c2coffeeandcandle.com

# cPanel/phpMyAdmin MySQL host and credentials.
DB_HOST=REPLACE_WITH_CPANEL_MYSQL_HOST
DB_PORT=3306
DB_USER=REPLACE_WITH_CPANEL_DB_USER
DB_PASSWORD=REPLACE_WITH_CPANEL_DB_PASSWORD
DB_NAME=REPLACE_WITH_CPANEL_DB_NAME
DB_CONNECTION_LIMIT=10

ACCESS_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Leave payment/provider credentials blank until those routes are implemented.
BILLPLZ_BASE_URL=
BILLPLZ_COLLECTION_ID=
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=

# Required for production OTP and customer support email delivery.
EMAIL_SMTP_HOST=REPLACE_WITH_SMTP_HOST
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=REPLACE_WITH_SMTP_USER
EMAIL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM_ADDRESS=no-reply@c2coffeeandcandle.com
EMAIL_FROM_NAME=C2 Coffee & Candle
SUPPORT_EMAIL_ADDRESS=support@c2coffeeandcandle.com

# Rotating Admin Web refresh sessions use an HttpOnly cookie. Leave blank for
# a host-only API cookie, or use .c2coffeeandcandle.com when required.
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAME_SITE=none

# Leave FCM false until the JSON service account is stored in the deployment
# secret store. Never place the JSON credential in source control.
FCM_DELIVERY_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=

# Required only when a Windows Print Bridge or approved POS connector is live.
PRINT_CONNECTOR_SHARED_SECRET=
