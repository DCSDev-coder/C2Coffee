Options -MultiViews
RewriteEngine On

<IfModule mod_headers.c>
  # Keep browser execution limited to this application, its API, and the
  # Firebase/Google endpoints required for barista push notifications.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.c2coffeeandcandle.com https://*.googleapis.com https://fcmregistrations.googleapis.com; img-src 'self' data: blob: https://api.c2coffeeandcandle.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Serve the React application for client-side routes while preserving real files.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
