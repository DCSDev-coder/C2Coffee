# The C2 Coffee API URL. Use HTTPS in production.
C2_API_URL=https://api.example.com

# Must exactly match PRINT_CONNECTOR_SHARED_SECRET in the API environment.
C2_PRINT_CONNECTOR_SHARED_SECRET=replace-with-a-long-random-secret

# This is the connector ID saved in Admin, not the printer IP address.
PRINTER_REFERENCE=c2-broga-zy905

# First supported transport: generic LAN/Wi-Fi ESC/POS receipt printers.
PRINTER_TRANSPORT=network_escpos
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# Keep true for the first API-only test. Change to false for a physical print.
DRY_RUN=true
POLL_INTERVAL_MS=2000
REQUEST_TIMEOUT_MS=10000
